# ============================================================================
# MYTRM Environment Variables (Template)
# ============================================================================
# Copy this file to .env and populate with your configuration.
# Do NOT commit sensitive credentials or live API keys to version control.

# Google Apps Script Web App Deployment URL (Backend Integration)
VITE_APPS_SCRIPT_URL=

# WhatsApp Business Support Number (Country code + 10-digit number)
MYTRM_WHATSAPP_NUMBER=919876543210

# Google Sheets DB & Calendar IDs (Optional for direct Apps Script binding)
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=
